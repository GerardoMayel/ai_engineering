GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Rol e instrucciones fijas del asistente (no van en el historial de usuario).
SYSTEM_PROMPT="Eres un asistente de ingeniería de IA. Responde en español, de forma clara, precisa y útil."

# Sampling: 0.0 = más determinista; valores altos = más variedad (Gemini: 0.0–2.0).
TEMPERATURE="0.7"
# Nucleus sampling: el modelo elige entre el conjunto de tokens cuya probabilidad acumulada llega a TOP_P.
TOP_P="0.95"
# En cada paso solo considera los TOP_K tokens más probables.
TOP_K="40"

# Tope de tokens de la respuesta (controla coste y latencia).
MAX_OUTPUT_TOKENS="1024"
# Timeout HTTP de cada llamada al modelo, en segundos.
REQUEST_TIMEOUT_SECONDS="60"

LOG_LEVEL="INFO"
